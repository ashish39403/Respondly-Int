# Local API environment. Copy to apps/api/.env. Do not commit the copy.

# Neon Auth. Issuer is the origin of this URL. Tokens are EdDSA and last 15 minutes.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Pooled application traffic, and a direct URL for SQL migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Browser origins allowed to call this API with a bearer token.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
