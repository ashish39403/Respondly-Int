# Neon Auth. Filled in when authentication is wired. Do not commit real values.
# NEON_AUTH_COOKIE_SECRET must be at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# FastAPI origin. The browser sends a bearer token. It does not send the Neon session cookie.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
